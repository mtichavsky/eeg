        <mxCell id="arr3" edge="1" parent="1" source="cnn_container" style="endArrow=classic;html=1;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="reshape2" value="">
