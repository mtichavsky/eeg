        </mxCell>
        <mxCell id="chan_flatten_proj" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Linear Projection (chan_proj)&lt;/b&gt;&lt;br&gt;(B×W&#39;, 8, 16×H&#39;) → (B×W&#39;, 8, chan_d_model=128)&lt;/font&gt;" vertex="1">
          <mxGeometry height="45" width="350" x="239" y="885" as="geometry" />
        </mxCell>
        <mxCell id="chan_transformer" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;TransformerEncoder&lt;/b&gt;&lt;br&gt;d_model=128, nhead=8, 1 layer (pre-norm)&lt;br&gt;(B×W&#39;, 8, 128)  — attends across 8 channel tokens&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="350" x="239" y="935" as="geometry" />
        </mxCell>
        <mxCell id="chan_gate" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Gate Linear + Softmax&lt;/b&gt;&lt;br&gt;Channel importance weights: (B×W&#39;, 8, 1) — softmax over 8 channels&lt;/font&gt;" vertex="1">
          <mxGeometry height="45" width="350" x="239" y="1000" as="geometry" />
        </mxCell>
        <mxCell id="chan_weighted_sum" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Weighted Sum + Reshape&lt;/b&gt; (restore time axis)&lt;br&gt;(B×W&#39;, 128) → (B, W&#39;, 128)&lt;br&gt;&lt;i&gt;W&#39; time steps, each with channel-merged features&lt;/i&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="350" x="239" y="1050" as="geometry" />
        </mxCell>
