          <mxGeometry height="30" width="400" x="174" y="785" as="geometry" />
        </mxCell>
        <mxCell id="diff_note" parent="1" style="shape=callout;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;align=left;position2=0.29;" value="&lt;b&gt;Key difference vs V2:&lt;/b&gt; W&#39; is folded into&lt;br&gt;the batch (not mean-pooled) so attention&lt;br&gt;is computed per time frame independently." vertex="1">
          <mxGeometry height="90" width="230" x="604" y="770" as="geometry" />
        </mxCell>
        <mxCell id="chan_permute" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Permute + Fold W&#39; into Batch&lt;/b&gt;&lt;br&gt;(B, 8, 16, H&#39;, W&#39;) → (B×W&#39;, 8, 16×H&#39;)&lt;br&gt;&lt;i&gt;Each time frame becomes its own batch item&lt;/i&gt;&lt;/font&gt;" vertex="1">
