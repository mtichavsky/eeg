<mxfile host="app.diagrams.net" agent="Mozilla/5.0 (X11; Linux x86_64; rv:146.0) Gecko/20100101 Firefox/146.0" version="29.2.9">
  <diagram name="SmallerAll Architecture" id="smallerall-arch">
    <mxGraphModel dx="1064" dy="560" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1" value="SmallerAll: Multi-Channel EEG Classification&lt;br&gt;(Single Conv3d Kernel Spanning All 8 Channels + LSTM)" vertex="1">
          <mxGeometry height="55" width="700" x="64" y="20" as="geometry" />
        </mxCell>

        <!-- Input -->
        <mxCell id="input" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Input&lt;/b&gt;&lt;br&gt;8-Channel Spectrograms&lt;br&gt;(B, 8, H, W)&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="220" x="304" y="90" as="geometry" />
        </mxCell>

        <!-- Arrow 1 -->
        <mxCell id="arr1" edge="1" parent="1" source="input" target="reshape1" style="endArrow=classic;html=1;strokeWidth=2;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Reshape: add depth dim -->
        <mxCell id="reshape1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Add Depth Dimension (unsqueeze)&lt;/b&gt;&lt;br&gt;(B, 8, H, W) → (B, 1, 8, H, W)&lt;br&gt;&lt;i&gt;8 EEG channels become the depth dim of a 3D volume&lt;/i&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="65" width="450" x="189" y="185" as="geometry" />
        </mxCell>

        <!-- Arrow 2 -->
        <mxCell id="arr2" edge="1" parent="1" source="reshape1" target="cnn_container" style="endArrow=classic;html=1;strokeWidth=2;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- CNN Block container -->
        <mxCell id="cnn_container" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=3;dashed=1;" value="" vertex="1">
          <mxGeometry height="440" width="500" x="164" y="270" as="geometry" />
        </mxCell>
        <mxCell id="cnn_label" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;" value="&lt;b style=&quot;font-size: 16px;&quot;&gt;CNN Block&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="200" x="174" y="275" as="geometry" />
        </mxCell>

        <!-- Conv3d - block 1 -->
        <mxCell id="conv1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Conv3d&lt;/b&gt;&lt;br&gt;1 → 32 channels&lt;br&gt;kernel: (8, 10, 10), stride: (1, 2, 2)&lt;br&gt;&lt;i&gt;Depth kernel=8 spans ALL EEG channels at once&lt;/i&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="340" x="244" y="308" as="geometry" />
        </mxCell>
        <!-- Callout note for Conv3d -->
        <mxCell id="conv3d_note" parent="1" style="shape=callout;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;align=left;" value="Rigid: one fixed spatial filter&lt;br&gt;learns a single cross-channel&lt;br&gt;weighting — all-or-nothing." vertex="1">
          <mxGeometry height="60" width="190" x="590" y="320" as="geometry" />
        </mxCell>
        <mxCell id="relu1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;ReLU&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="25" width="340" x="244" y="393" as="geometry" />
        </mxCell>
        <mxCell id="pool1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;AdaptiveMaxPool3d((1, None, None))&lt;/b&gt;&lt;br&gt;Collapse depth → (B, 32, 1, H', W')&lt;/font&gt;" vertex="1">
          <mxGeometry height="45" width="340" x="244" y="423" as="geometry" />
        </mxCell>
        <mxCell id="drop1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontColor=#333333;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Dropout3d&lt;/b&gt; (p=dropout)&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="340" x="244" y="473" as="geometry" />
        </mxCell>
        <mxCell id="squeeze" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Squeeze depth dim&lt;/b&gt;&lt;br&gt;(B, 32, 1, H', W') → (B, 32, H', W')&lt;/font&gt;" vertex="1">
          <mxGeometry height="45" width="340" x="244" y="508" as="geometry" />
        </mxCell>

        <!-- Conv2d - block 2 -->
        <mxCell id="conv2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Conv2d&lt;/b&gt;&lt;br&gt;32 → 16 channels, kernel: 5×5&lt;/font&gt;" vertex="1">
          <mxGeometry height="50" width="340" x="244" y="560" as="geometry" />
        </mxCell>
        <mxCell id="relu2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;ReLU&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="25" width="340" x="244" y="615" as="geometry" />
        </mxCell>
        <mxCell id="pool2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;MaxPool2d&lt;/b&gt; kernel: 2×2, stride: 1&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="340" x="244" y="645" as="geometry" />
        </mxCell>
        <mxCell id="drop2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontColor=#333333;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Dropout2d&lt;/b&gt; (p=dropout)&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="340" x="244" y="680" as="geometry" />
        </mxCell>
        <mxCell id="cnn_out_label" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;i&gt;(B, 16, H', W')&lt;/i&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="25" width="120" x="164" y="680" as="geometry" />
        </mxCell>

        <!-- Arrow 3 -->
        <mxCell id="arr3" edge="1" parent="1" source="cnn_container" target="reshape2" style="endArrow=classic;html=1;strokeWidth=2;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Permute + reshape for LSTM -->
        <mxCell id="reshape2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Permute + Reshape&lt;/b&gt;&lt;br&gt;(B, 16, H', W') → (B, W', H'×16)&lt;br&gt;&lt;i&gt;W' as sequence length, H'×16 as features per time step&lt;/i&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="65" width="420" x="204" y="730" as="geometry" />
        </mxCell>

        <!-- Arrow 4 -->
        <mxCell id="arr4" edge="1" parent="1" source="reshape2" target="lstm_block" style="endArrow=classic;html=1;strokeWidth=2;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- LSTM block -->
        <mxCell id="lstm_block" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;LSTM&lt;/b&gt;&lt;br&gt;input_size=H'×16, hidden_size=rnn_hidden (default 64), batch_first=True&lt;br&gt;Take last hidden state → (B, rnn_hidden)&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="380" x="224" y="820" as="geometry" />
        </mxCell>

        <!-- Arrow 5 -->
        <mxCell id="arr5" edge="1" parent="1" source="lstm_block" target="classifier_container" style="endArrow=classic;html=1;strokeWidth=2;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Classifier head container -->
        <mxCell id="classifier_container" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6ffcc;strokeColor=#82b366;strokeWidth=3;dashed=1;" value="" vertex="1">
          <mxGeometry height="175" width="500" x="164" y="915" as="geometry" />
        </mxCell>
        <mxCell id="classifier_label" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;" value="&lt;b style=&quot;font-size: 16px;&quot;&gt;Classifier Head&lt;/b&gt;" vertex="1">
          <mxGeometry height="30" width="140" x="174" y="920" as="geometry" />
        </mxCell>
        <mxCell id="dropout" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontColor=#333333;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Dropout&lt;/b&gt; (p=dropout)&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="270" x="279" y="950" as="geometry" />
        </mxCell>
        <mxCell id="fc1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Linear (fc1)&lt;/b&gt;: rnn_hidden → 32 + ReLU&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="270" x="279" y="985" as="geometry" />
        </mxCell>
        <mxCell id="fc2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Linear (fc2)&lt;/b&gt;: 32 → 16 + ReLU&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="270" x="279" y="1020" as="geometry" />
        </mxCell>
        <mxCell id="out_fc" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Linear (out)&lt;/b&gt;: 16 → num_classes&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="270" x="279" y="1055" as="geometry" />
        </mxCell>

        <!-- Arrow 6 -->
        <mxCell id="arr6" edge="1" parent="1" source="classifier_container" target="output" style="endArrow=classic;html=1;strokeWidth=2;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Output -->
        <mxCell id="output" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Output&lt;/b&gt;&lt;br&gt;Logits (B, num_classes)&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="200" x="314" y="1110" as="geometry" />
        </mxCell>

        <!-- Parameter count annotation -->
        <mxCell id="param_note" parent="1" style="text;html=1;strokeColor=#6c8ebf;fillColor=#dae8fc;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;" value="&lt;b&gt;~148K–290K parameters&lt;/b&gt; depending on rnn_hidden (default 64). Cross-channel mixing done once, upfront, by the 3D conv kernel — no ongoing cross-channel reasoning." vertex="1">
          <mxGeometry height="40" width="500" x="164" y="1185" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
