#!/usr/bin/env bash
#
# Generic PBS job template for one training run on Metacentrum (PBS Pro).
# One qsub submission = one experiment on one GPU; the scheduler places it
# wherever a free GPU exists, so a whole sweep is just N independent
# `qsub` calls (see ../run-bipolar-meta.sh / ../run-round1-atv4-meta.sh)
# instead of manually picking CUDA_VISIBLE_DEVICES on a fixed 4-GPU box.
#
# Loosely follows the pattern of the old KNN-project jobs at
# ~/mit/knn/p/metacentrum/{train_model_job,evaluate_job} (PBS -l select,
# clean_scratch trap), adapted for this repo's Poetry env and CLI.
#
# Usage (do not qsub this file directly — EXP_NAME/MAIN_ARGS are required):
#   qsub -N "$name" -v "EXP_NAME=$name,MAIN_ARGS=$args" metacentrum/train_job.pbs
#
#PBS -N eeg_train
#PBS -q gpu
# cl_fobos=False: the fobos (ZCU) nodes can't see packages installed into the
#   shared $REPO_DIR/.venv (numpy/torch missing there despite the venv being
#   verified intact from the frontend) - a storage-visibility issue specific
#   to that cluster, not a transient one (reproduced on both fobos2 and fobos19).
# cl_grogu=False: grogu (CERIT-SC) nodes carry sm_120 (Blackwell) GPUs, which
#   our installed torch==2.11.0+cu126 wheel has no compiled kernels for
#   ("CUDA error: no kernel image is available for execution on the device").
#   Drop this once torch is upgraded to a build with Blackwell support.
#PBS -l select=1:ncpus=2:ngpus=1:gpu_mem=20gb:mem=24gb:scratch_local=10gb:cl_fobos=False:cl_grogu=False
#PBS -l walltime=05:00:00
#PBS -j oe
#PBS -m ae

set -uo pipefail

# ---- Matches the real layout confirmed on skirit.ics.muni.cz ------------
STORAGE_HOME="/storage/brno2/home/${PBS_O_LOGNAME}"
REPO_DIR="$STORAGE_HOME/eeg"              # git clone target (holds the shared .venv), see setup steps
# CODE_DIR: where main.py is run from. Defaults to REPO_DIR; override with `qsub -v CODE_DIR=...`
# to run an experiment branch from a separate git worktree without switching the shared clone.
CODE_DIR="${CODE_DIR:-$REPO_DIR}"
DATA_DIR="$STORAGE_HOME"                  # CANE/ MDD/ SAD/ IDUN_IN_EAR/ live directly here
PYTHON_MODULE="python"                    # confirmed working: ~/.bash_history has `module load python`
# No CUDA module needed: torch is installed from the pytorch-cuda (cu126) wheel,
# which bundles its own CUDA runtime.
# ---------------------------------------------------------------------------

: "${EXP_NAME:?set via qsub -v EXP_NAME=...}"
: "${MAIN_ARGS:?set via qsub -v MAIN_ARGS=\"...\"}"

trap 'clean_scratch' TERM EXIT
cd "$SCRATCHDIR" || exit 2
clean_scratch

printf -- "-----------------------------------------------------------\n"
printf "JOB ID:    %s\nJOB NAME:  %s\nNODE:      %s\nEXP:       %s\nSTART:     %s\n" \
    "$PBS_JOBID" "$PBS_JOBNAME" "$HOSTNAME" "$EXP_NAME" "$(date +%Y-%m-%d_%H-%M)"
printf "ARGS:      %s\n" "$MAIN_ARGS"
printf -- "-----------------------------------------------------------\n"

echo "Loading modules..."
module add "$PYTHON_MODULE"

echo "Activating shared venv at $REPO_DIR/.venv ..."
cd "$CODE_DIR" || { echo "CODE_DIR $CODE_DIR not found - run the one-time setup first"; exit 2; }
source "$REPO_DIR/.venv/bin/activate"

OUT_DIR="$STORAGE_HOME/experiments/$EXP_NAME"
mkdir -p "$OUT_DIR"

echo "Starting training: $EXP_NAME"
# shellcheck disable=SC2086
EEG_DATA_DIR="$DATA_DIR" python main.py train \
    --checkpoint-dir="$OUT_DIR" $MAIN_ARGS \
    2>&1 | tee "$OUT_DIR/stdout.log"

echo "Done. Results in $OUT_DIR"
clean_scratch
